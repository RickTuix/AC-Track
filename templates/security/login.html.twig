{% extends 'base.html.twig' %}

{% block title %}Sign In — AC.TRACK{% endblock %}

{% block public %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3" style="width: 56px; height: 56px;">
                            <i class="bi bi-mortarboard-fill fs-3" aria-hidden="true"></i>
                        </div>
                        <h1 class="h3 fw-bold mb-1">AC.TRACK</h1>
                        <p class="text-muted small">Academics &amp; Incomplete-Grade Resolution Tracker</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}" novalidate>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                                <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus placeholder="Enter your username">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                                <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required placeholder="Enter your password">
                            </div>
                        </div>

                        <button class="btn btn-primary w-100 py-2 fw-semibold" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i> Sign In
                        </button>
                    </form>
                </div>
            </div>

            <!-- Demo Credentials Helper Accordion -->
            <div class="card border border-primary-subtle bg-light">
                <div class="card-body p-3">
                    <h2 class="h6 fw-bold text-primary mb-2 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i> Seeded Demo Accounts
                    </h2>
                    <p class="text-muted small mb-2">Use password <code>password123</code> for all accounts:</p>
                    <div class="row g-2 small">
                        <div class="col-4">
                            <span class="badge bg-dark w-100 py-1">Admin</span>
                            <div class="font-monospace text-center mt-1">admin</div>
                        </div>
                        <div class="col-4">
                            <span class="badge bg-info text-dark w-100 py-1">Teacher</span>
                            <div class="font-monospace text-center mt-1">teacher.santos</div>
                        </div>
                        <div class="col-4">
                            <span class="badge bg-success w-100 py-1">Student</span>
                            <div class="font-monospace text-center mt-1">student01</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
