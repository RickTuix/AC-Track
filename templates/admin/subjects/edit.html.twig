{% extends 'base.html.twig' %}

{% block title %}Edit Subject: {{ subject.code }} — AC.TRACK{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Admin</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_subjects') }}">Subjects</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit {{ subject.code }}</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h1 class="h4 fw-bold mb-1">Edit Subject Details</h1>
                    <p class="text-muted small mb-0">{{ subject.code }} &bull; {{ subject.title }}</p>
                </div>
                <div class="card-body p-4">
                    <form method="post" action="{{ path('admin_subject_edit', {'id': subject.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('edit_subject_' ~ subject.id) }}">
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label for="code" class="form-label fw-semibold">Subject Code</label>
                                <input type="text" name="code" id="code" class="form-control" value="{{ subject.code }}" required>
                            </div>
                            <div class="col-md-7">
                                <label for="title" class="form-label fw-semibold">Subject Title</label>
                                <input type="text" name="title" id="title" class="form-control" value="{{ subject.title }}" required>
                            </div>
                            <div class="col-md-2">
                                <label for="units" class="form-label fw-semibold">Units</label>
                                <input type="number" name="units" id="units" class="form-control" value="{{ subject.units }}" min="1" max="6" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">Description</label>
                            <textarea name="description" id="description" class="form-control" rows="3">{{ subject.description }}</textarea>
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a href="{{ path('admin_subjects') }}" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
