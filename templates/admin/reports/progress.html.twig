{% extends 'base.html.twig' %}

{% block title %}Academic Progress Report — AC.TRACK{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Academic Progress &amp; INC Resolution Report</h1>
            <p class="text-muted mb-0">Descriptive overview of student grades, recorded requirements, and resolution rates by section.</p>
        </div>
        <div class="d-flex gap-2">
            {% if selectedSection %}
                <a href="{{ path('admin_reports_progress', {'section_id': selectedSection.id, 'format': 'csv'}) }}" class="btn btn-outline-success btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-file-earmark-spreadsheet-fill" aria-hidden="true"></i> Export CSV
                </a>
                <a href="{{ path('admin_reports_progress', {'section_id': selectedSection.id, 'format': 'pdf'}) }}" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i> Export PDF
                </a>
            {% endif %}
        </div>
    </div>

    <!-- Section Selection Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ path('admin_reports_progress') }}" class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <label for="sectionSelect" class="form-label small fw-bold text-muted mb-1">Select Cohort / Section</label>
                    <select name="section_id" id="sectionSelect" class="form-select" onchange="this.form.submit()">
                        {% for sec in sections %}
                            <option value="{{ sec.id }}" {{ selectedSection and selectedSection.id == sec.id ? 'selected' : '' }}>
                                {{ sec.name }} &mdash; {{ sec.academicYear }} ({{ sec.semester }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted small text-uppercase fw-bold">Cohort Report</span>
                <div class="h5 fw-bold mb-0 text-primary">{{ selectedSection ? selectedSection.name : 'No section selected' }}</div>
            </div>
            <span class="small text-muted">{{ progressData|length }} Students Evaluated</span>
        </div>
        <div class="card-body p-0">
            {% if progressData is empty %}
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder2-open fs-1 text-secondary mb-2 d-block" aria-hidden="true"></i>
                    <p class="mb-0">No student enrollment records found for this section.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" aria-label="Academic Progress Report Table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Student ID</th>
                                <th scope="col">Student Name</th>
                                <th scope="col" class="text-center">Year Level</th>
                                <th scope="col" class="text-center">Recorded Grades</th>
                                <th scope="col" class="text-center">Grade Average</th>
                                <th scope="col" class="text-center">Pending INCs</th>
                                <th scope="col" class="text-center">Submitted INCs</th>
                                <th scope="col" class="text-center">Completed INCs</th>
                                <th scope="col" class="text-center">Resolution Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in progressData %}
                                {% set st = item.student %}
                                <tr>
                                    <td class="font-monospace fw-bold">{{ st.studentNumber }}</td>
                                    <td>
                                        <div class="fw-bold">{{ st.lastName }}, {{ st.firstName }}</div>
                                    </td>
                                    <td class="text-center text-muted">{{ st.yearLevel }}</td>
                                    <td class="text-center fw-medium">{{ item.totalGrades }}</td>
                                    <td class="text-center font-monospace fw-bold {{ item.gpa >= 75 ? 'text-success' : 'text-danger' }}">
                                        {{ item.gpa > 0 ? item.gpa|number_format(2) : 'N/A' }}
                                    </td>
                                    <td class="text-center">
                                        {% if item.pending > 0 %}
                                            <span class="badge bg-warning text-dark">{{ item.pending }}</span>
                                        {% else %}
                                            <span class="text-muted">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if item.submitted > 0 %}
                                            <span class="badge bg-info text-dark">{{ item.submitted }}</span>
                                        {% else %}
                                            <span class="text-muted">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if item.completed > 0 %}
                                            <span class="badge bg-success">{{ item.completed }}</span>
                                        {% else %}
                                            <span class="text-muted">0</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if item.status == 'NEEDS ATTENTION' %}
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-exclamation-circle-fill me-1" aria-hidden="true"></i> Needs Attention
                                            </span>
                                        {% elseif item.status == 'UNDER REVIEW' %}
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i> Under Review
                                            </span>
                                        {% else %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> All Clear
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        <div class="card-footer bg-light p-3 small text-muted">
            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
            Descriptive academic analytics based on recorded grading period marks and active Incomplete-Grade (INC) records.
        </div>
    </div>
</div>
{% endblock %}
