{% extends 'base.html.twig' %}

{% block title %}Faculty Class Assignments — AC.TRACK{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Faculty &amp; Course Assignments</h1>
            <p class="text-muted mb-0">Assign instructors to specific subjects within sections.</p>
        </div>
        <div>
            <button class="btn btn-primary d-flex align-items-center gap-1" data-bs-toggle="collapse" data-bs-target="#newAssignmentForm">
                <i class="bi bi-person-check-fill" aria-hidden="true"></i> Assign Faculty to Subject
            </button>
        </div>
    </div>

    <!-- Assignment Collapse Form -->
    <div class="collapse mb-4" id="newAssignmentForm">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white py-3">
                <h2 class="h6 mb-0 fw-bold">New Course-Faculty Assignment</h2>
            </div>
            <div class="card-body p-4">
                <form method="post" action="{{ path('admin_assignments') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('new_assignment') }}">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label for="section_id" class="form-label fw-semibold">Section / Cohort <span class="text-danger">*</span></label>
                            <select name="section_id" id="section_id" class="form-select" required>
                                <option value="">-- Choose Section --</option>
                                {% for s in sections %}
                                    <option value="{{ s.id }}">{{ s.name }} ({{ s.academicYear }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="subject_id" class="form-label fw-semibold">Subject / Course <span class="text-danger">*</span></label>
                            <select name="subject_id" id="subject_id" class="form-select" required>
                                <option value="">-- Choose Subject --</option>
                                {% for sub in subjects %}
                                    <option value="{{ sub.id }}">{{ sub.code }} &mdash; {{ sub.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="teacher_id" class="form-label fw-semibold">Assigned Instructor <span class="text-danger">*</span></label>
                            <select name="teacher_id" id="teacher_id" class="form-select" required>
                                <option value="">-- Choose Faculty Member --</option>
                                {% for t in teachers %}
                                    <option value="{{ t.id }}">{{ t.fullName }} ({{ t.department }})</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#newAssignmentForm">Cancel</button>
                        <button type="submit" class="btn btn-primary fw-semibold px-4">Save Assignment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" aria-label="Faculty Assignments Table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Section</th>
                            <th scope="col">Subject</th>
                            <th scope="col">Assigned Instructor</th>
                            <th scope="col">Enrolled Students</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if assignments is empty %}
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No faculty course assignments recorded.
                                </td>
                            </tr>
                        {% else %}
                            {% for ss in assignments %}
                                <tr>
                                    <td class="fw-bold">{{ ss.section.name }}</td>
                                    <td>
                                        <div class="fw-semibold text-primary">{{ ss.subject.code }}</div>
                                        <div class="small text-muted">{{ ss.subject.title }}</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">{{ ss.teacher.fullName }}</div>
                                        <small class="text-muted">{{ ss.teacher.department }}</small>
                                    </td>
                                    <td>{{ ss.section.students|length }} students</td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('admin_assignment_delete', {'id': ss.id}) }}" class="d-inline" onsubmit="return confirm('Remove this instructor assignment?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_assignment_' ~ ss.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove assignment">
                                                <i class="bi bi-trash" aria-hidden="true"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
