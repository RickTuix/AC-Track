{% extends 'base.html.twig' %}

{% block title %}Audit Trail — AC.TRACK{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Academic Audit Trail</h1>
            <p class="text-muted mb-0">Immutable records of grade modifications, INC resolutions, deadline alterations, and status changes.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_audit_logs') }}" class="btn btn-sm {{ currentAction is empty ? 'btn-dark' : 'btn-outline-secondary' }}">
                All Actions
            </a>
            <a href="{{ path('admin_audit_logs', {'action': 'GRADE_UPDATE'}) }}" class="btn btn-sm {{ currentAction == 'GRADE_UPDATE' ? 'btn-dark' : 'btn-outline-secondary' }}">
                Grade Updates
            </a>
            <a href="{{ path('admin_audit_logs', {'action': 'INC_CREATE'}) }}" class="btn btn-sm {{ currentAction == 'INC_CREATE' ? 'btn-dark' : 'btn-outline-secondary' }}">
                INC Issued
            </a>
            <a href="{{ path('admin_audit_logs', {'action': 'INC_STATUS_CHANGE'}) }}" class="btn btn-sm {{ currentAction == 'INC_STATUS_CHANGE' ? 'btn-dark' : 'btn-outline-secondary' }}">
                INC Status Transitions
            </a>
            <a href="{{ path('admin_audit_logs', {'action': 'INC_EDIT'}) }}" class="btn btn-sm {{ currentAction == 'INC_EDIT' ? 'btn-dark' : 'btn-outline-secondary' }}">
                INC Edits
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            {% if logs is empty %}
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-shield-check fs-1 text-secondary mb-2 d-block" aria-hidden="true"></i>
                    <p class="mb-0">No audit events match your criteria.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 font-monospace small" aria-label="System Audit Trail">
                        <thead class="table-light font-sans-serif">
                            <tr>
                                <th scope="col" style="width: 170px;">Timestamp</th>
                                <th scope="col" style="width: 160px;">Action Type</th>
                                <th scope="col" style="width: 160px;">Initiating User</th>
                                <th scope="col" style="width: 140px;">Entity</th>
                                <th scope="col">Recorded Changes / Delta (Old &rarr; New)</th>
                                <th scope="col" class="text-end" style="width: 110px;">IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in logs %}
                                <tr>
                                    <td class="text-nowrap text-muted">{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
                                    <td>
                                        {% if log.action == 'GRADE_UPDATE' %}
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">{{ log.action }}</span>
                                        {% elseif log.action in ['INC_STATUS_CHANGE', 'INC_CREATE'] %}
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle">{{ log.action }}</span>
                                        {% elseif log.action == 'INC_EDIT' %}
                                            <span class="badge bg-info-subtle text-dark border border-info-subtle">{{ log.action }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-dark border">{{ log.action }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="fw-bold text-dark">
                                        {{ log.user ? log.user.displayName : 'System Daemon' }}
                                    </td>
                                    <td>
                                        <span class="text-secondary">{{ log.entityType }}</span>
                                        {% if log.entityId %}
                                            <span class="text-muted">#{{ log.entityId }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if log.oldValue and log.newValue %}
                                            <div class="d-flex flex-column gap-1">
                                                <div><span class="text-danger fw-bold">Before:</span> {{ log.oldValue|json_encode }}</div>
                                                <div><span class="text-success fw-bold">After:</span> {{ log.newValue|json_encode }}</div>
                                            </div>
                                        {% elseif log.newValue %}
                                            <div><span class="text-success fw-bold">Values:</span> {{ log.newValue|json_encode }}</div>
                                        {% else %}
                                            <span class="text-muted">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end text-muted">{{ log.ipAddress ?: 'Local/CLI' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
