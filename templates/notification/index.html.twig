{% extends 'base.html.twig' %}

{% block title %}Notification Center — AC.TRACK{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Academic Notifications</h1>
            <p class="text-muted mb-0">Internal academic alerts, INC requirement deadlines, and submission updates.</p>
        </div>
        {% if unreadCount > 0 %}
            <form method="post" action="{{ path('app_notifications_read_all') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('read_all_notifs') }}">
                <button type="submit" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                    <i class="bi bi-check2-all" aria-hidden="true"></i> Mark All as Read
                </button>
            </form>
        {% endif %}
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            {% if notifications is empty %}
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-bell-slash fs-1 text-secondary mb-2 d-block" aria-hidden="true"></i>
                    <h2 class="h5 fw-bold text-dark mb-1">No Notifications Yet</h2>
                    <p class="mb-0 text-muted">When instructors post or update requirements, notifications will appear here.</p>
                </div>
            {% else %}
                <div class="list-group list-group-flush">
                    {% for notif in notifications %}
                        <div class="list-group-item p-3 {{ notif.isRead ? '' : 'bg-light border-start border-primary border-4' }}">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    {% if notif.type == 'INC_CREATED' %}
                                        <i class="bi bi-file-earmark-plus-fill text-primary fs-5" aria-hidden="true"></i>
                                    {% elseif notif.type in ['DEADLINE_APPROACHING', 'DEADLINE_OVERDUE'] %}
                                        <i class="bi bi-alarm-fill text-danger fs-5" aria-hidden="true"></i>
                                    {% elseif notif.type == 'INC_COMPLETED' %}
                                        <i class="bi bi-patch-check-fill text-success fs-5" aria-hidden="true"></i>
                                    {% elseif notif.type in ['SUBMISSION_CONFIRMATION', 'SUBMISSION_RECEIVED'] %}
                                        <i class="bi bi-cloud-arrow-up-fill text-info fs-5" aria-hidden="true"></i>
                                    {% else %}
                                        <i class="bi bi-info-circle-fill text-secondary fs-5" aria-hidden="true"></i>
                                    {% endif %}
                                    <h3 class="h6 fw-bold mb-0 {{ notif.isRead ? 'text-dark' : 'text-primary' }}">{{ notif.title }}</h3>
                                    {% if not notif.isRead %}
                                        <span class="badge bg-primary fs-8">NEW</span>
                                    {% endif %}
                                </div>
                                <small class="text-muted text-nowrap">{{ notif.createdAt|date('M d, Y h:i A') }}</small>
                            </div>
                            <p class="text-muted small mb-2 ms-4">{{ notif.message }}</p>
                            <div class="ms-4">
                                {% if notif.link %}
                                    <a href="{{ path('app_notification_read', {'id': notif.id}) }}" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                                        View Details &rarr;
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
